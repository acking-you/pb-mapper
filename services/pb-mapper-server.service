[Unit]
Description=pb-mapper public relay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=RUST_LOG=info
EnvironmentFile=-/etc/pb-mapper/server.env
ExecStart=/usr/local/bin/pb-mapper server --port 7666 --use-machine-msg-header-key
Restart=on-failure
RestartSec=3
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
