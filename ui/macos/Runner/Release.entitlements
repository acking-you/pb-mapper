<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- No App Sandbox: an app that posts input to other apps cannot be
     sandboxed (the sandbox denies synthesizing events), and the app ships
     outside the App Store, signed with Developer ID and the Hardened Runtime.
     Network access and the user's Downloads need no entitlement outside it. -->
