{
  "name": "pb-mapper",
  "version": "0.5.0",
  "description": "Node-API client for a deployed pb-mapper relay",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "require": "./index.js",
      "default": "./index.js"
    }
  },
  "license": "MIT",
  "homepage": "https://github.com/acking-you/pb-mapper#readme",
  "bugs": {
    "url": "https://github.com/acking-you/pb-mapper/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/acking-you/pb-mapper.git",
    "directory": "js"
  },
  "keywords": [
    "tunnel",
    "tcp",
    "udp",
    "napi-rs",
    "node-api"
  ],
  "files": [
    "index.js",
    "index.d.ts",
    "README.md",
    "pb-mapper.win32-x64-msvc.node"
  ],
  "packageManager": "bun@1.3.9",
  "scripts": {
    "artifacts": "napi artifacts --output-dir artifacts",
    "build": "napi build --platform --manifest-path ../crates/pb-mapper-node/Cargo.toml --output-dir .",
    "build:release": "napi build --platform --profile release-node --strip --manifest-path ../crates/pb-mapper-node/Cargo.toml --output-dir .",
    "test": "bun test"
  },
  "napi": {
    "binaryName": "pb-mapper",
    "packageName": "pb-mapper",
    "targets": [
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-pc-windows-msvc"
    ]
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.3.0"
  },
  "optionalDependencies": {
    "pb-mapper-darwin-arm64": "0.5.0",
    "pb-mapper-darwin-x64": "0.5.0",
    "pb-mapper-linux-arm64-gnu": "0.5.0",
    "pb-mapper-linux-x64-gnu": "0.5.0"
  },
  "engines": {
    "node": ">= 18",
    "bun": ">= 1.1"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
