{
  "name": "pb-mapper",
  "version": "0.4.0",
  "description": "Node-API client for a deployed pb-mapper relay",
  "main": "index.js",
  "types": "index.d.ts",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/acking-you/pb-mapper.git"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "*.node"
  ],
  "packageManager": "bun@1.3.9",
  "scripts": {
    "build": "napi build --platform --manifest-path ../crates/pb-mapper-node/Cargo.toml --output-dir .",
    "build:release": "napi build --platform --profile release-node --strip --manifest-path ../crates/pb-mapper-node/Cargo.toml --output-dir .",
    "test": "bun test"
  },
  "napi": {
    "binaryName": "pb-mapper",
    "packageName": "pb-mapper",
    "targets": [
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-pc-windows-msvc"
    ]
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.3.0"
  },
  "engines": {
    "node": ">= 18",
    "bun": ">= 1.1"
  }
}
